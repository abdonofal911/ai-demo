{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./src/*"],
      // whisper.rn 0.7.4's package "exports" has no root entry, so TypeScript can't find
      // its types for `import 'whisper.rn'`. Point it at the published .d.ts directly.
      // (Metro falls back to the package's "react-native"/"main" field at runtime.)
      "whisper.rn": ["./node_modules/whisper.rn/lib/typescript/index.d.ts"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
